# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Supabase — Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Project Settings > API > JWT Settings > JWT Secret (used to verify auth tokens)
SUPABASE_JWT_SECRET=your-jwt-secret

# Direct Postgres connection (Supabase > Project Settings > Database)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Auth — set to false for local single-user development (skips token checks)
AUTH_ENABLED=true

# App
CORS_ORIGINS=http://localhost:5173
